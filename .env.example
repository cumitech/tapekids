# App
NEXT_PUBLIC_API_URL=/api
SESSION_SECRET=replace-with-a-long-random-string

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=kids_event_cameroon
MYSQL_USER=root
MYSQL_PASSWORD=

# First admin (used by `npm run db:seed`)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=admin

# Password for seeded role logins (`npm run db:seed`)
# superadmin@seed.kidsevent.cm  (super-admin)
# admin@seed.kidsevent.cm  (admin)
# staff@seed.kidsevent.cm  (staff)
# guest@seed.kidsevent.cm  (guest)
SEED_PASSWORD=SeedPass123!

# Public app URL (invitation links, CamPay redirects)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CamPay (https://documenter.getpostman.com/view/2391374/T1LV8PVA)
# DEV uses https://demo.campay.net unless CAMPAY_BASE_URL is set.
# PROD uses https://www.campay.net unless CAMPAY_BASE_URL is set.
# Register webhook: {APP_URL}/api/payments/campay/webhook
# CAMPAY_ENVIRONMENT=PROD uses real event fees. DEV uses CAMPAY_TEST_AMOUNT.
CAMPAY_ENABLED=false
CAMPAY_ENVIRONMENT=DEV
CAMPAY_CURRENCY=XAF
CAMPAY_TEST_AMOUNT=2
CAMPAY_BASE_URL=https://demo.campay.net/api
CAMPAY_WEBHOOK_SECRET=
CAMPAY_APPID=
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
CAMPAY_ACCESS_TOKEN=

# Mailgun HTTP API (https://documentation.mailgun.com/docs/mailgun/api-reference)
# Use the Private API key from Settings → API security — not the SMTP password.
# Domain region must match MAILGUN_BASE_URL:
#   EU → https://api.eu.mailgun.net
#   US → https://api.mailgun.net
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_BASE_URL=https://api.eu.mailgun.net
MAILGUN_FROM=
MAILGUN_FROM_NAME=Kids Events Cameroon
# Optional SMTP credentials (not used by the HTTP sender)
# MAILGUN_LOGIN=
# MAILGUN_PASSWORD=
# MAILGUN_SENDING_KEY=
COUNTRIES_NOW_API_URL=https://countriesnow.space/api/v0.1

